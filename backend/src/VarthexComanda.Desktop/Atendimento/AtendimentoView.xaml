<UserControl x:Class="VarthexComanda.Desktop.Atendimento.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VarthexComanda.Desktop.Atendimento"
             xmlns:catalogo="clr-namespace:VarthexComanda.Desktop.Catalogo"
             mc:Ignorable="d"
             Background="#FFF9F2" Foreground="{StaticResource Grafite}">
    <UserControl.Resources>
        <local:NuloParaVisibilidadeConverter x:Key="VisivelSeComandaAberta" />
        <local:NuloParaVisibilidadeInversoConverter x:Key="VisivelSeGrade" />
        <local:CentavosParaMoedaConverter x:Key="Moeda" />
        <local:CategoriaSelecionadaParaCorConverter x:Key="CorCategoria" />
        <catalogo:FotoArquivoParaImagemConverter x:Key="FotoImagem" />
        <local:ItemSelecionadoParaCorConverter x:Key="CorItemSelecionado" />
        <Style x:Key="PlaceholderBusca" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="#6B6259" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="PlaceholderNumero" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NovoNumero}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceholderProduto" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBusca}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TextoBuscaCatalogo}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding VerTotalCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">

        <Grid x:Name="PainelGrade" IsVisibleChanged="PainelGrade_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeGrade}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="COMANDAS" FontWeight="Bold" FontSize="12" Foreground="#47433F" Margin="0,0,0,10" />

            <Grid Grid.Row="1" Margin="0,0,0,12" Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="CampoNumeroComanda" ToolTip="Nº da comanda (Ctrl+N). Enter abre a comanda."
                         AutomationProperties.Name="Nº da comanda"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding NovoNumero, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="CampoNumero_PreviewTextInput"
                         PreviewKeyDown="CampoNumero_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AbrirCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Nº da comanda (Ctrl+N)" Style="{StaticResource PlaceholderNumero}" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4" Height="128" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AbrirOuSelecionarSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#D9CFC3" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="#23252A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Aberta}" Value="True">
                                                <Setter Property="Background" Value="#A95012" />
                                                <Setter Property="BorderBrush" Value="#C56820" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="COMANDA" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TempoFormatado}" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Numero, StringFormat='{}{0:00}'}"
                                               FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NomeCliente}" ToolTip="{Binding NomeCliente}" TextTrimming="CharacterEllipsis" FontSize="13" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TotalFormatado}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aberta}" Value="False">
                                                        <Setter Property="Text" Value="LIVRE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Foreground="#B23B32" Margin="0,12,0,0" />
        </Grid>

        <Grid x:Name="PainelEdicao" IsVisibleChanged="PainelEdicao_IsVisibleChanged"
              Visibility="{Binding ComandaAtual, Converter={StaticResource VisivelSeComandaAberta}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="#D9CFC3" />

            <Grid x:Name="PainelMenu" Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MENU" FontWeight="Bold" FontSize="12" Foreground="#47433F" Margin="0,0,0,8" />

                <!-- Ordem de Tab da tela: busca (0) > categorias (1) > cards do menu (2) > itens da comanda > Voltar > Cancelar > Finalizar -->
                <Grid Grid.Row="1" Margin="0,0,0,8" KeyboardNavigation.TabIndex="0">
                    <TextBox x:Name="CampoBusca" ToolTip="Buscar produto (Ctrl+F). Enter adiciona o primeiro resultado."
                             AutomationProperties.Name="Buscar produto"
                             Text="{Binding TextoBuscaCatalogo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Buscar produto (Ctrl+F)" Style="{StaticResource PlaceholderProduto}" />
                </Grid>

                <ScrollViewer Grid.Row="2" KeyboardNavigation.TabIndex="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProdutosCatalogo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="128" Height="128" Margin="0,0,8,8" Padding="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Background="White" BorderBrush="#D9CFC3" BorderThickness="1"
                                        Command="{Binding DataContext.AdicionarProdutoAoItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="#F3EAE0" ClipToBounds="True">
                                            <Image Source="{Binding FotoArquivo, Converter={StaticResource FotoImagem}}" Stretch="UniformToFill" />
                                        </Grid>
                                        <Border Grid.Row="1" BorderBrush="#D9CFC3" BorderThickness="0,1,0,0" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PrecoCentavos, Converter={StaticResource Moeda}}"
                                                           FontSize="10.5" Foreground="#47433F" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,8,0,0" KeyboardNavigation.TabIndex="1">
                    <Button DockPanel.Dock="Left" Content="Todas" Width="76" Height="48" Margin="0,0,6,0" Padding="4" FontSize="13"
                            Command="{Binding LimparFiltroCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#D9CFC3" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoriaCatalogo}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#F3EAE0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="48" Margin="0,0,6,0" Padding="4"
                                        Command="{Binding DataContext.SelecionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Background>
                                        <MultiBinding Converter="{StaticResource CorCategoria}">
                                            <Binding />
                                            <Binding Path="DataContext.CategoriaCatalogo" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Button.Background>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
                                            <Setter Property="BorderBrush" Value="#D9CFC3" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Content" Value="{Binding Nome}" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>

            <Grid Grid.Column="2" x:Name="PainelComanda" Focusable="True" KeyboardNavigation.IsTabStop="False"
                  FocusVisualStyle="{StaticResource FocoVisivel}" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock FontWeight="Bold" FontSize="12" Foreground="#47433F" Margin="0,0,0,8"
                           Text="{Binding ComandaAtual.Numero, StringFormat='COMANDA #{0}'}" />
                <TextBlock Text="Nome do cliente (opcional)" Margin="0,0,0,4" />
                <DockPanel>
                    <Button Content="Salvar nome" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Command="{Binding SalvarNomeClienteCommand}" />
                    <TextBox x:Name="CampoNomeCliente" AutomationProperties.Name="Nome do cliente (opcional)" MaxLength="80" Text="{Binding NomeCliente, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SalvarNomeClienteCommand}" /></TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#D9CFC3" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                    
                        <Grid Grid.Row="0" Background="#F3EAE0" Margin="0,0,17,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontSize="12" FontWeight="Bold" Foreground="#47433F"
                                       Margin="8,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="QTD." FontSize="12" FontWeight="Bold" Foreground="#47433F"
                                       Margin="0,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="PREÇO" FontSize="12" FontWeight="Bold" Foreground="#47433F"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#47433F"
                                       Margin="0,6,8,6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Itens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#D9CFC3" BorderThickness="0,0,0,1" Padding="0,4"
                                                GotKeyboardFocus="LinhaItem_GotKeyboardFocus"
                                                PreviewMouseLeftButtonDown="LinhaItem_PreviewMouseLeftButtonDown">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource CorItemSelecionado}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.ItemSelecionadoId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="184" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Grid.ColumnSpan="5" Width="5" HorizontalAlignment="Left"
                                                        IsHitTestVisible="False" Margin="0,-4">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource CorItemSelecionado}" ConverterParameter="Marca">
                                                            <Binding Path="Id" />
                                                            <Binding Path="DataContext.ItemSelecionadoId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Column="0" Text="{Binding NomeProduto}" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding PrecoUnitarioCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding SubtotalCentavos, Converter={StaticResource Moeda}}" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Content="−" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.DiminuirQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="+" Width="44" Height="44" FontSize="20" FontWeight="Bold"
                                                            Command="{Binding DataContext.AumentarQuantidadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                    <Button Content="Excluir" Foreground="#B23B32" Height="44" MinHeight="44" Padding="12,0"
                                                            Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="2" Margin="2,10,2,10">
                    <TextBlock Text="TOTAL DA COMANDA" FontWeight="Bold" FontSize="12" Foreground="#47433F" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding ComandaAtual.TotalCentavos, Converter={StaticResource Moeda}}"
                               FontWeight="Bold" FontSize="24" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                </DockPanel>

                <DockPanel Grid.Row="3">
                    <Button DockPanel.Dock="Right" Content="Finalizar comanda (F4)" Padding="20,0" Height="60" FontSize="16"
                            Background="#26734D" Foreground="White" FontWeight="Bold" ToolTip="Finalizar comanda (F4)"
                            KeyboardNavigation.TabIndex="1"
                            Command="{Binding VerTotalCommand}" />
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabIndex="0">
                        <Button Content="Voltar" Padding="16,0" Height="60" FontSize="16" ToolTip="Voltar para as comandas (Esc)"
                                Command="{Binding FecharEdicaoCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancelar comanda" Padding="16,0" Height="60" FontSize="16" Foreground="#B23B32"
                                ToolTip="Cancelar comanda (sem atalho; alcance por Tab)"
                                Command="{Binding CancelarComandaAtualCommand}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="4" Text="{Binding Mensagem}" Foreground="#B23B32" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
