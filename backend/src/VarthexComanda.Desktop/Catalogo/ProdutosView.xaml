<UserControl x:Class="VarthexComanda.Desktop.Catalogo.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VarthexComanda.Desktop.Catalogo"
             xmlns:atendimento="clr-namespace:VarthexComanda.Desktop.Atendimento"
             mc:Ignorable="d">
    <UserControl.Resources>
        <local:FotoArquivoParaImagemConverter x:Key="FotoImagem" />
        <local:CaminhoArquivoParaImagemConverter x:Key="CaminhoImagem" />
        <atendimento:CentavosParaMoedaConverter x:Key="Moeda" />
        <atendimento:NuloParaVisibilidadeConverter x:Key="VisivelSeEdicao" />
        <atendimento:NuloParaVisibilidadeInversoConverter x:Key="VisivelSeNovo" />
        <!-- Enter grava: so o botao de gravar visivel (Cadastrar ou Salvar) e o padrao; o colapsado nunca compete -->
        <Style x:Key="BotaoGravarPadrao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Setter Property="IsDefault" Value="True" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Categoria:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="160" ItemsSource="{Binding Categorias}" DisplayMemberPath="Nome"
                      SelectedItem="{Binding CategoriaFiltro}" Margin="0,0,12,0" />
            <Button Content="Limpar filtro" Command="{Binding LimparFiltroCommand}" Margin="0,0,12,0" />
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="CampoBuscaProduto" Width="190" ToolTip="Buscar produto (Ctrl+F)"
                     Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <ListView Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding Produtos}"
                  SelectedItem="{Binding ProdutoSelecionado}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Nome}" Width="260" />
                    <GridViewColumn Header="Preço" DisplayMemberBinding="{Binding PrecoCentavos, Converter={StaticResource Moeda}}" Width="110" />
                    <GridViewColumn Header="Ativo" DisplayMemberBinding="{Binding Ativo}" Width="80" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                BorderBrush="#C4C4C4" BorderThickness="1" Background="White" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TituloFormulario}" FontWeight="Bold" FontSize="14"
                           Foreground="#23252A" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FOTO" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Grid Width="140" Height="140" Background="#EDEDEA" ClipToBounds="True">
                                <Image Source="{Binding FotoArquivoAtual, Converter={StaticResource FotoImagem}}" Stretch="UniformToFill" />
                                <Image Source="{Binding FotoPendenteCaminho, Converter={StaticResource CaminhoImagem}}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                                <Button Content="Escolher foto..." Click="EscolherFoto_Click" Padding="12,6" Margin="0,0,0,6" />
                                <Button Content="Remover foto" Command="{Binding RemoverFotoCommand}" Padding="12,6" Margin="0,0,0,6" />
                                <TextBlock Text="JPG, PNG ou BMP · até 10 MB" FontSize="11" Foreground="#6B6B67" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="NOME DO PRODUTO" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NomeProduto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="CATEGORIA" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categorias}" DisplayMemberPath="Nome"
                                  SelectedItem="{Binding CategoriaProduto}" Margin="0,0,0,12" />

                        <TextBlock Text="PREÇO (R$)" FontWeight="Bold" FontSize="12" Foreground="#4A4A47" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PrecoProdutoReais, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <CheckBox Content="Ativo" IsChecked="{Binding ProdutoAtivo}" Margin="0,0,0,12"
                                  Visibility="{Binding ProdutoSelecionado, Converter={StaticResource VisivelSeEdicao}}" />

                        <Expander Header="Nova categoria">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox Text="{Binding NovaCategoriaNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AdicionarCategoriaCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="Adicionar categoria" Command="{Binding AdicionarCategoriaCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding Mensagem}" Foreground="#B23B32" TextWrapping="Wrap" Margin="0,8,0,0" />

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="BotaoCadastrar" Style="{StaticResource BotaoGravarPadrao}" DockPanel.Dock="Right" Content="Cadastrar produto" Padding="20,0" Height="60" FontSize="16"
                            Background="#3F8F5F" Foreground="White" FontWeight="Bold"
                            Command="{Binding SalvarCommand}"
                            Visibility="{Binding ProdutoSelecionado, Converter={StaticResource VisivelSeNovo}}" />
                    <Button x:Name="BotaoSalvar" Style="{StaticResource BotaoGravarPadrao}" DockPanel.Dock="Right" Content="Salvar" Padding="20,0" Height="60" FontSize="16"
                            Background="#3F8F5F" Foreground="White" FontWeight="Bold"
                            Command="{Binding SalvarCommand}"
                            Visibility="{Binding ProdutoSelecionado, Converter={StaticResource VisivelSeEdicao}}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ProdutoSelecionado, Converter={StaticResource VisivelSeEdicao}}">
                        <Button Content="Novo produto" Padding="16,0" Height="60" FontSize="16"
                                Command="{Binding NovoCommand}" Margin="0,0,8,0" />
                        <Button Content="Desativar" Padding="16,0" Height="60" FontSize="16" Foreground="#B23B32"
                                Command="{Binding DesativarCommand}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
