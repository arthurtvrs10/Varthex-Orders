<Application x:Class="VarthexComanda.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VarthexComanda.Desktop">
    <Application.Resources>
        <!-- Foco visivel de alto contraste (RNF18): contorno azul solido de 3 px, sem pontilhado. -->
        <Style x:Key="FocoVisivel" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle Stroke="#1F5FBF" StrokeThickness="3" Margin="-3"
                                   SnapsToDevicePixels="True" IsHitTestVisible="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tamanhos para uso por toque (campos e botoes >= 46 px). Valores locais nas telas prevalecem. -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Resources>
                <!-- O botao do calendario interno do DatePicker nao deve herdar o tamanho de toque dos botoes. -->
                <Style TargetType="Button" />
            </Style.Resources>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Application.Resources>
</Application>
